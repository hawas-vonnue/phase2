{
    "scripts": {
        "build": "tsc",
        "start": "npm run build -- -w",
        "test": "jest",
        "dev": "npx tsx src/ticketExpress.ts",
        "setup:db": "npm run db:generate && npm run db:reset && npm run db:seed",
        "db:generate": "npx prisma generate",
        "db:reset": "npx prisma migrate reset -f",
        "db:seed": "npx tsx src/seed.ts",
        "init": "psql mydb -f init.sql && npx tsx src/seed.ts"
    },
