{
    "openapi": "3.0.0",
    "info": {
        "title": "ticket support API",
        "version": "1.0.0",
        "description": "API documentation for the ticket support system"
    },
    "components": {
        "securitySchemes": {
            "BearerAuth": {
                "type": "http",
                "scheme": "bearer",
                "bearerFormat": "JWT"
            }
        }
    },
    "paths": {
        "/health": {
            "get": {
                "description": "Health endpoint",
                "parameters": [],
                "responses": {
                    "200": {
                        "description": "OK"
                    }
                }
            }
        },
        "/login": {
            "post": {
                "description": "User and customer login",
                "tags": ["Authentication"],
                "security": [{ "BearerAuth": [] }],
                "parameters": [],
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "type": "object",
                                "required": ["email", "password", "type"],
                                "properties": {
                                    "email": {
                                        "type": "string",
                                        "example": "user1@gmail.com"
                                    },
                                    "password": {
                                        "type": "string",
                                        "example": "default"
                                    },
                                    "type": {
                                        "type": "string",
                                        "enum": ["user", "customer"],
                                        "example": "user"
                                    }
                                }
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "Login successful",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object",
                                    "properties": {
                                        "status": {
                                            "type": "string"
                                        },
                                        "token": {
                                            "type": "string"
                                        },
                                        "user": {
                                            "type": "object"
                                        }
                                    }
                                }
                            }
                        }
                    },
                    "403": {
                        "description": "Invalid credentials"
                    },
                    "400": {
                        "description": "Bad request",
                        "content": {
                            "text/plain": {
                                "schema": {
                                    "type": "string",
                                    "example": "Bad Request"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/categories/create": {
            "post": {
                "description": "create new ticket category",
                "tags": ["Categories"],
                "parameters": [],
                "security": [{ "BearerAuth": [] }],
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "type": "object",
                                "required": ["category"],
                                "properties": {
                                    "category": {
                                        "type": "string",
                                        "example": "Hardware support"
                                    }
                                }
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "Created category"
                    },
                    "403": {
                        "description": "Forbidden.",
                        "content": {
                            "text/plain": {
                                "schema": {
                                    "type": "string",
                                    "example": "forbidden"
                                }
                            }
                        }
                    },
                    "400": {
                        "description": "Bad request",
                        "content": {
                            "text/plain": {
                                "schema": {
                                    "type": "string",
                                    "example": "Bad Request"
                                }
                            }
                        }
                    },
                    "401": {
                        "description": "Invalid token"
                    }
                }
            }
        },

        "/customers/register": {
            "post": {
                "description": "Create a new customer account",
                "tags": ["customers"],
                "parameters": [],
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "type": "object",
                                "required": ["email", "password", "name"],
                                "properties": {
                                    "email": {
                                        "type": "string",
                                        "example": "customer@gmail.com"
                                    },
                                    "password": {
                                        "type": "string",
                                        "example": "default"
                                    },
                                    "name": {
                                        "type": "string",
                                        "example": "customer 1"
                                    }
                                }
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "customer created successfuly"
                    },
                    "400": {
                        "description": "Bad request",
                        "content": {
                            "text/plain": {
                                "schema": {
                                    "type": "string",
                                    "example": "Bad Request"
                                }
                            }
                        }
                    },
                    "401": {
                        "description": "Invalid token"
                    }
                }
            }
        },

        "/users": {
            "get": {
                "description": "Get current user",
                "tags": ["Users"],
                "security": [{ "BearerAuth": [] }],
                "parameters": [],
                "responses": {
                    "200": {
                        "description": "user object"
                    },
                    "401": {
                        "description": "Invalid token"
                    }
                }
            }
        },

        "/users/register": {
            "post": {
                "description": "Create a user account",
                "tags": ["Users"],
                "security": [{ "BearerAuth": [] }],
                "parameters": [],
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "type": "object",
                                "required": ["email", "password", "name"],
                                "properties": {
                                    "email": {
                                        "type": "string",
                                        "example": "user@gmail.com"
                                    },
                                    "password": {
                                        "type": "string",
                                        "example": "default"
                                    },
                                    "name": {
                                        "type": "string",
                                        "example": "user 1"
                                    }
                                }
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "user created successfuly"
                    },
                    "403": {
                        "description": "Forbidden.",
                        "content": {
                            "text/plain": {
                                "schema": {
                                    "type": "string",
                                    "example": "forbidden"
                                }
                            }
                        }
                    },
                    "400": {
                        "description": "Bad request",
                        "content": {
                            "text/plain": {
                                "schema": {
                                    "type": "string",
                                    "example": "Bad Request"
                                }
                            }
                        }
                    },
                    "401": {
                        "description": "Invalid token"
                    }
                }
            }
        },
        "/tickets": {
            "get": {
                "description": "To get all tickets based on filters",
                "tags": ["Tickets"],
                "security": [{ "BearerAuth": [] }],
                "parameters": [
                    {
                        "name": "page",
                        "in": "query",
                        "required": false,
                        "schema": {
                            "type": "integer"
                        }
                    },
                    {
                        "name": "pageSize",
                        "in": "query",
                        "required": false,
                        "description": "The number of items per page(maximum 100)",
                        "schema": {
                            "type": "integer"
                        }
                    },
                    {
                        "name": "sortField",
                        "in": "query",
                        "description": "The field by which to sort the results",
                        "required": false,
                        "schema": {
                            "type": "string",
                            "enum": [
                                "assigned_to",
                                "created_at",
                                "created_by",
                                "description",
                                "priority",
                                "status",
                                "title"
                            ]
                        }
                    },
                    {
                        "name": "sortDirection",
                        "in": "query",
                        "description": "The direction to sort the results.",
                        "required": false,
                        "schema": {
                            "type": "string",
                            "enum": ["asc", "desc"]
                        }
                    }
                ],

                "responses": {
                    "200": {
                        "description": "Successfully retrieved the list of tickets",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object",
                                    "properties": {
                                        "pageMetadata": {
                                            "type": "object",
                                            "properties": {
                                                "count": {
                                                    "type": "integer",
                                                    "description": "Total number of matching tickets"
                                                },
                                                "page": {
                                                    "type": "integer",
                                                    "description": "Current page number"
                                                },
                                                "pageSize": {
                                                    "type": "integer",
                                                    "description": "Number of tickets per page"
                                                },
                                                "totalPages": {
                                                    "type": "integer",
                                                    "description": "Total number of available pages."
                                                }
                                            }
                                        },
                                        "result": {
                                            "type": "array",
                                            "description": "Array of ticket objects",
                                            "items": {
                                                "type": "object"
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    },
                    "400": {
                        "description": "Bad request",
                        "content": {
                            "text/plain": {
                                "schema": {
                                    "type": "string",
                                    "example": "Bad Request"
                                }
                            }
                        }
                    },
                    "401": {
                        "description": "Invalid token"
                    },
                    "403": {
                        "description": "Forbidden.",
                        "content": {
                            "text/plain": {
                                "schema": {
                                    "type": "string",
                                    "example": "forbidden"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/tickets/create": {
            "post": {
                "summary": "Create a new support ticket",
                "tags": ["Tickets"],
                "security": [{ "BearerAuth": [] }],
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "type": "object",
                                "required": [
                                    "title",
                                    "description",
                                    "priority",
                                    "categoryId",
                                    "customerId"
                                ],
                                "properties": {
                                    "title": {
                                        "type": "string",
                                        "example": "Laptop won't boot"
                                    },
                                    "description": {
                                        "type": "string",
                                        "example": "Screen remains black when holding power key"
                                    },
                                    "priority": {
                                        "type": "string",
                                        "example": "Low"
                                    },
                                    "categoryId": {
                                        "type": "number",
                                        "example": "1"
                                    },
                                    "customerId": {
                                        "type": "number",
                                        "example": "1"
                                    }
                                }
                            }
                        }
                    }
                },
                "responses": {
                    "201": { "description": "Ticket created successfully" },
                    "403": {
                        "description": "Forbidden.",
                        "content": {
                            "text/plain": {
                                "schema": {
                                    "type": "string",
                                    "example": "forbidden"
                                }
                            }
                        }
                    },
                    "400": {
                        "description": "Bad request",
                        "content": {
                            "text/plain": {
                                "schema": {
                                    "type": "string",
                                    "example": "Bad Request"
                                }
                            }
                        }
                    },
                    "401": {
                        "description": "Invalid token"
                    }
                }
            }
        },

        "/tickets/{id}": {
            "get": {
                "summary": "View a ticket by ID",
                "tags": ["Tickets"],
                "security": [{ "BearerAuth": [] }],
                "parameters": [
                    {
                        "name": "id",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "number",
                            "example": "1"
                        }
                    }
                ],
                "responses": {
                    "200": { "description": "Ticket details retrieved" },
                    "403": {
                        "description": "Forbidden.",
                        "content": {
                            "text/plain": {
                                "schema": {
                                    "type": "string",
                                    "example": "forbidden"
                                }
                            }
                        }
                    },
                    "401": { "description": "Invalid token" },
                    "404": { "description": "Ticket not found" }
                }
            },
            "delete": {
                "summary": "Delete a ticket",
                "tags": ["Tickets"],
                "security": [{ "BearerAuth": [] }],
                "parameters": [
                    {
                        "name": "id",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "number",
                            "example": "1"
                        }
                    }
                ],
                "responses": {
                    "200": { "description": "Ticket deleted successfully" },
                    "401": { "description": "Invalid token" },
                    "403": {
                        "description": "Forbidden.",
                        "content": {
                            "text/plain": {
                                "schema": {
                                    "type": "string",
                                    "example": "forbidden"
                                }
                            }
                        }
                    },
                    "404": { "description": "Ticket not found" }
                }
            }
        },
        "/tickets/status/{id}": {
            "patch": {
                "summary": "Update ticket status",
                "tags": ["Tickets"],
                "security": [{ "BearerAuth": [] }],
                "parameters": [
                    {
                        "name": "id",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "number",
                            "example": "1"
                        }
                    }
                ],
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "type": "object",
                                "required": ["newStatus"],
                                "properties": {
                                    "newStatus": {
                                        "type": "string",
                                        "example": "resolved"
                                    }
                                }
                            }
                        }
                    }
                },
                "responses": {
                    "200": { "description": "Status updated successfully" },
                    "403": {
                        "description": "Forbidden.",
                        "content": {
                            "text/plain": {
                                "schema": {
                                    "type": "string",
                                    "example": "forbidden"
                                }
                            }
                        }
                    },
                    "400": {
                        "description": "Bad request",
                        "content": {
                            "text/plain": {
                                "schema": {
                                    "type": "string",
                                    "example": "Bad Request"
                                }
                            }
                        }
                    },
                    "401": {
                        "description": "Invalid token"
                    },
                    "404": { "description": "Not found" }
                }
            }
        },
        "/tickets/assign/{id}": {
            "post": {
                "summary": "Assign ticket to a user",
                "tags": ["Tickets"],
                "security": [{ "BearerAuth": [] }],
                "parameters": [
                    {
                        "name": "id",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "number",
                            "example": "1"
                        }
                    }
                ],
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "type": "object",
                                "required": ["assignee"],
                                "properties": {
                                    "assignee": {
                                        "type": "number",
                                        "example": "1"
                                    }
                                }
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "Ticket assigned successfully"
                    },

                    "403": {
                        "description": "Forbidden.",
                        "content": {
                            "text/plain": {
                                "schema": {
                                    "type": "string",
                                    "example": "forbidden"
                                }
                            }
                        }
                    },
                    "400": {
                        "description": "Bad request",
                        "content": {
                            "text/plain": {
                                "schema": {
                                    "type": "string",
                                    "example": "Bad Request"
                                }
                            }
                        }
                    },
                    "401": { "description": "Invalid token" },
                    "404": { "description": "Not found" }
                }
            }
        }
    }
}
